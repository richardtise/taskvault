# TaskVault contract deployment configuration.
# Copy to contracts/.env and fill in. contracts/.env is gitignored.

# Deployer wallet. Retains DEFAULT_ADMIN_ROLE, ADMIN_ROLE and VERIFIER_ROLE after
# deployment — use a dedicated deployer and move admin to a multisig for mainnet.
PRIVATE_KEY=0x...

# Robinhood Chain RPCs. The public endpoints are rate-limited; use a dedicated
# provider for anything beyond light testing.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Blockscout API key, used for `--verify`.
ETHERSCAN_API_KEY=your_blockscout_api_key

# Deployment parameters
# USDG_ADDRESS is OPTIONAL: leave it unset (or zero) and Deploy.s.sol will deploy
# a 6-decimal MockUSDG — convenient on a fresh testnet with no USDG yet.
# USDG_ADDRESS=0x...
TREASURY_ADDRESS=0x...    # Receives forfeited funds from cancelled streams
