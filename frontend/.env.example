# TaskVault frontend configuration.
# Copy to frontend/.env. frontend/.env is gitignored — never commit it.
#
# IMPORTANT: Vite inlines VITE_* variables at BUILD time. After changing these
# you must rebuild (npm run build / docker compose build frontend).

# Robinhood Chain RPCs. The public endpoints are rate-limited — supply a
# dedicated provider URL here for anything beyond light testing.
VITE_ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
VITE_ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com

# Contract addresses from the deployment (see DEPLOYMENT.md step 1).
# The UI shows a configuration error and disables on-chain actions until these
# are real addresses.
VITE_VAULT_ADDRESS=0x...
VITE_USDG_ADDRESS=0x...
