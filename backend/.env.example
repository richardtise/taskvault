# Server
PORT=3001
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/taskvault
REDIS_URL=redis://localhost:6379

# Blockchain
RPC_URL=https://rpc.testnet.chain.robinhood.com
PRIVATE_KEY=0x...                    # Backend wallet (verifier)
VAULT_ADDRESS=0x...                  # TaskVault contract
POINTS_ADDRESS=0x...                 # TaskVaultPoints contract
USDG_ADDRESS=0x...                   # USDG token

# IPFS
IPFS_API_URL=https://ipfs.infura.io:5001
IPFS_PROJECT_ID=your_infura_project_id
IPFS_PROJECT_SECRET=your_infura_secret

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Admin
ADMIN_WALLET=0x...                   # Your admin wallet address

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
