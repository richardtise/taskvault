# TaskVault backend configuration.
# Copy to backend/.env and fill in. backend/.env is gitignored — never commit it.

# --- Server ---
PORT=3001
NODE_ENV=production
# Comma-separated list of allowed browser origins for CORS.
FRONTEND_URL=http://localhost:5173
# Number of proxy hops to trust for client IPs (1 behind the bundled nginx).
TRUST_PROXY=1

# --- Database ---
# Local development (`npm run dev`): the line below is correct.
# Under Docker Compose this value is OVERRIDDEN by docker-compose.yml, which
# injects the bundled MongoDB URI. To point Compose at Atlas/another cluster,
# set MONGODB_URI in the repo-root .env instead (see DEPLOYMENT.md).
MONGODB_URI=mongodb://localhost:27017/taskvault

# --- Logging ---
LOG_LEVEL=info
LOG_DIR=logs

# --- Blockchain ---
# Robinhood Chain testnet (chainId 46630). The public RPC is rate-limited —
# use a dedicated provider key for anything beyond light testing.
RPC_URL=https://rpc.testnet.chain.robinhood.com
# Dedicated verifier bot wallet. Must hold VERIFIER_ROLE on the vault and gas.
PRIVATE_KEY=0x...
# TaskVault contract address (NOT the points token).
VAULT_ADDRESS=0x...

# --- Auth ---
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_me_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d

# --- Admin ---
# Wallet(s) allowed to call /api/admin/*. Comma-separate for multiple.
ADMIN_WALLET=0x...

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Verifier bot ---
VERIFIER_INTERVAL_MS=30000
VERIFIER_BATCH_SIZE=10
